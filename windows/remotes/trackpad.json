{
  "id": "am.trackpad",
  "name": "Trackpad",
  "icon": "◉",
  "color": "#5b8cff",
  "description": "Large touchpad with every key and live typing",
  "layout": {
    "type": "grid",
    "tools": [
      { "type": "keyboardToggle" },
      { "type": "keysToggle" }
    ],
    "rows": [
      {
        "panel": true,
