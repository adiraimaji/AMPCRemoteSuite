      {
        "weight": 1,
        "children": [
          { "type": "trackpad", "hint": "Tap = left · 2 fingers = right · 3 fingers = middle · double-tap or hold, then drag · 2 fingers = scroll" }
        ]
      }
    ]
  },
  "actions": {}
}
